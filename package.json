{
	"name": "werpc",
	"version": "0.0.6",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/werpc.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/werpc/issues"
	},
	"homepage": "https://github.com/pajecawav/werpc#readme",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"play": "pnpm --filter=playground dev",
		"play:build": "pnpm --filter=playground build",
		"play:e2e": "pnpm play:build && pnpm --filter=playground e2e",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "pt format",
		"lint:package": "publint",
		"format": "pt format --write",
		"prepare": "pt prepare",
		"prepublishOnly": "cross-env FORCE_COLOR=1 npm-run-all -p -l lint:* test -s build"
	},
	"dependencies": {
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0"
	},
	"devDependencies": {
		"@pajecawav/tools": "^0.1.0",
		"@rsbuild/core": "^2.2.13",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"chrome-types": "^0.1.457",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"web-ext": "^10.8.0"
	},
	"packageManager": "pnpm@12.14.0"
}
